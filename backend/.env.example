# SkillProof Environment Configuration
PORT=8001
HOST=0.0.0.0
DATABASE_URL=sqlite:///./skillproof.db
JWT_SECRET=skillproof-super-secure-jwt-secret-key-2026-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Evaluation Settings
# The system automatically picks up GEMINI_API_KEY from environment or here:
# GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
# Evaluation provider can be 'ai' or 'mock'
EVALUATION_PROVIDER=ai
